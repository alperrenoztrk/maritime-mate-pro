# 🔐 Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 🤖 AI API Keys (for Supabase Edge Functions - store in Supabase Secrets, not here)
# GEMINI_API_KEY=your_gemini_api_key_here
# WOLFRAM_API_KEY=your_wolfram_api_key_here

# 🌍 Microsoft Translator (store in Supabase Secrets)
# MICROSOFT_TRANSLATOR_KEY=your_translator_key_here
# MICROSOFT_TRANSLATOR_REGION=global

# 📢 Google AdMob (mobil uygulama reklamları)
#
# ANA ANAHTAR — varsayılan KAPALI. Yalnızca değer açıkça "true" ise reklamlar
# etkinleşir; tanımsız/boş/başka her değerde AdMob SDK hiç başlatılmaz, onay
# formu açılmaz, banner ve geçiş reklamı hiç istenmez (bkz. areAdsEnabled(),
# src/config/ads.ts). İlk mağaza sürümü reklamsız çıkacağı için kapalıdır.
#
# Reklamı açmak için: VITE_ADS_ENABLED=true YAPIN **ve** aşağıdaki dört AdMob
# kimliğini birden doldurun. Anahtar açık ama kimlikler boşsa Google'ın TEST
# reklamları gösterilir; bu üretimde AdMob politikası ihlalidir.
VITE_ADS_ENABLED=false

# Reklam birimi kimlikleri. Boş bırakılırsa (anahtar açıkken) Google'ın resmi
# TEST reklamları gösterilir — geliştirme ve CI için doğru davranış budur.
# Gerçek kimlikleri yalnızca mağaza derlemelerinde doldurun; bir platformun
# kimliği doldurulduğunda o platform canlı reklama geçer
# (bkz. src/config/ads.ts, ADVERTISEMENT_SETUP.md).
#
# App ID'ler JS'te DEĞİL, native tarafta okunur:
#   Android → android/admob.properties veya ADMOB_APP_ID_ANDROID ortam değişkeni
#   iOS     → ios/App/App/Info.plist içindeki GADApplicationIdentifier
VITE_ADMOB_BANNER_ID_ANDROID=
VITE_ADMOB_INTERSTITIAL_ID_ANDROID=
VITE_ADMOB_BANNER_ID_IOS=
VITE_ADMOB_INTERSTITIAL_ID_IOS=

# 💰 Google AdSense (web reklamları) — şu an kullanılmıyor.
# Web tarafında reklam yok; üretim CSP'si (vite.config.ts) harici script'leri
# engeller. Açılacaksa önce CSP'ye Google alan adları eklenmelidir.
# VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# 📱 Mobile App Configuration
VITE_APP_NAME=Maritime Calculator
VITE_APP_VERSION=1.0.0
VITE_PACKAGE_NAME=com.marinersbook.app

# 📚 Paid Maritime Resources
# (optional) Configure paid resources if used
