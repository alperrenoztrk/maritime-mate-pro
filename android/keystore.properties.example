# Release imzalama için bu dosyayı `keystore.properties` olarak kopyalayın
# ve gerçek değerleri girin. keystore.properties git'e ASLA eklenmez.
#
# Keystore oluşturma:
#   keytool -genkey -v -keystore marine-expert-pro.keystore \
#     -alias marine-key -keyalg RSA -keysize 2048 -validity 10000
storeFile=/tam/yol/marine-expert-pro.keystore
storePassword=***
keyAlias=marine-key
keyPassword=***
